---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AgentFilter from '../../components/AgentFilter';
import { agents } from '../../data/agents';
---

<BaseLayout title="AI Agentics | Agents" description="Directory and interactive explorer for the AI Agentics roles.">
  <section class="mb-8">
    <h1 class="text-3xl font-bold text-white sm:text-4xl">Agent Directory</h1>
    <p class="mt-3 max-w-2xl text-slate-300">
      Explore each agent role with searchable metadata, responsibilities, and direct profile links.
    </p>
  </section>

  <AgentFilter agents={agents} client:load />
</BaseLayout>
