---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { agents, getAgentBySlug } from '../../data/agents';

export function getStaticPaths() {
  return agents.map((agent) => ({ params: { slug: agent.slug } }));
}

const agent = getAgentBySlug(Astro.params.slug ?? '');

if (!agent) {
  return Astro.redirect('/agents');
}
---

<BaseLayout title={`AI Agentics | ${agent.name}`} description={agent.tagline}>
  <a href="/agents" class="text-sm text-cyan-300 hover:text-cyan-200">← Back to directory</a>
  <article class="mt-4 rounded-2xl border border-slate-800 bg-slate-900/70 p-6 sm:p-8">
    <p class="text-sm uppercase tracking-widest text-cyan-300">Agent Profile</p>
    <h1 class="mt-2 text-3xl font-bold text-white sm:text-4xl">{agent.name}</h1>
    <p class="mt-3 text-slate-300">{agent.mission}</p>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      <section>
        <h2 class="text-lg font-semibold text-white">Strengths</h2>
        <ul class="mt-3 space-y-2 text-sm text-slate-300">
          {agent.strengths.map((item) => <li>• {item}</li>)}
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">Responsibilities</h2>
        <ul class="mt-3 space-y-2 text-sm text-slate-300">
          {agent.responsibilities.map((item) => <li>• {item}</li>)}
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">Interactions</h2>
        <ul class="mt-3 space-y-2 text-sm text-slate-300">
          {agent.interactions.map((item) => <li>• {item}</li>)}
        </ul>
      </section>
    </div>
  </article>
</BaseLayout>
