---
import BaseLayout from '../layouts/BaseLayout.astro';
import AgentCard from '../components/AgentCard.astro';
import { agents } from '../data/agents';
---

<BaseLayout title="AI Agentics | Home" description="Modern interactive overview of the AI Agentics repository and agents.">
  <section class="grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-center">
    <div>
      <p class="text-sm uppercase tracking-widest text-cyan-300">Repository Overview</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl">AI Agentics, explained clearly.</h1>
      <p class="mt-4 max-w-2xl text-base text-slate-300 sm:text-lg">
        This site documents the repo intent and the core agents used to plan, research, validate, and orchestrate delivery.
        Explore role responsibilities, strengths, and interactions through a responsive, data-driven experience.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/agents" class="rounded-lg bg-cyan-300 px-4 py-2 text-sm font-semibold text-slate-900 transition hover:bg-cyan-200">Browse agents</a>
        <a href="/agents/orchestrator" class="rounded-lg border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-100 transition hover:bg-slate-800">Start with Orchestrator</a>
      </div>
    </div>
    <div class="rounded-2xl border border-slate-800 bg-gradient-to-br from-cyan-500/10 via-slate-900 to-indigo-500/10 p-6">
      <h2 class="text-lg font-semibold text-white">What this website includes</h2>
      <ul class="mt-4 space-y-3 text-sm text-slate-300">
        <li>• Homepage with repository narrative and quick actions</li>
        <li>• Agents directory with client-side search</li>
        <li>• Detail pages generated from reusable metadata</li>
        <li>• Accessible semantics, keyboard focus states, responsive layout</li>
      </ul>
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-semibold text-white">Featured agents</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      {agents.map((agent) => <AgentCard agent={agent} />)}
    </div>
  </section>
</BaseLayout>
